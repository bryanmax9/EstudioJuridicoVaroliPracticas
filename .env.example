# Google Service Account JSON key (entire file content as a single-line JSON string)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"varoli-cv@YOUR_PROJECT.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# The ID found in your Google Drive folder URL:
# https://drive.google.com/drive/folders/THIS_IS_THE_FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# ── Panel de gestión ("Sistema de Arbitraje") login ─────────────────────────
# Generate these by running: node scripts/generate-panel-credentials.js
# Never commit real values — set them in Netlify → Site settings →
# Environment variables instead.
PANEL_ADMIN_EMAIL=tu-correo@ejemplo.com
PANEL_ADMIN_PASSWORD_HASH=salt_hex:hash_hex
PANEL_SESSION_SECRET=random_64_char_hex_string

# ── Netlify Blobs (almacenamiento del panel: clientes, expedientes, tareas,
#    usuarios, y ahora también la caché del módulo Arbitraje) ───────────────
# Netlify solo inyecta credenciales de Blobs automáticamente en "Functions
# v2"; las funciones de este repo usan el formato clásico "exports.handler"
# (v1), así que sin esto TODO /panel (no solo Arbitraje) falla con:
# "The environment has not been configured to use Netlify Blobs."
# BLOBS_SITE_ID: Netlify → tu sitio → Project configuration → General →
#   Project information → "Project ID".
# BLOBS_TOKEN: Netlify → tu perfil de usuario (ícono arriba a la derecha) →
#   User settings → Applications → Personal access tokens → New access
#   token. Es un token de cuenta completo — trátalo como una contraseña,
#   nunca lo pegues en el chat, solo en Netlify → Environment variables.
BLOBS_SITE_ID=tu_project_id
BLOBS_TOKEN=tu_personal_access_token

# ── Panel → módulo Arbitraje (sync en vivo con Google Sheets) ───────────────
# Reutiliza el service account de GOOGLE_SERVICE_ACCOUNT_KEY de arriba.
# Ese service account (el valor de su "client_email") debe estar agregado
# como Lector en el libro de Drive "Templo 2- Clientes" — Compartir → pegar
# ese correo → Lector. Sin eso, /panel-arbitraje devuelve un error 502.
# Opcional: solo si cambias de libro de origen.
PANEL_ARBITRAJE_SHEET_ID=1EwQ5TjPc2JpKn2Q0IRS3Kx6NqcLBFUJe
